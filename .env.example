# .env - Локальный файл окружения стека Arcane
# Права доступа к файлу обязательно ограничить: chmod 600 .env

#################
# ИМЯ ПРОЕКТА И БАЗОВЫЕ НАСТРОЙКИ
#################
COMPOSE_PROJECT_NAME=core-arcane-local
TZ=Europe/Moscow

#################
# ВЕРСИИ ОБРАЗОВ
# curl -s https://api.github.com/repos/getarcaneapp/arcane/releases/latest | grep '"tag_name":'
#################
ARCANE_IMAGE=ghcr.io/getarcaneapp/manager:v2.17.2

#################
# ПЕРЕМЕННЫЕ ARCANE
#################
# 32-байтный hex-ключ (обязательно сгенерировать свой командой: openssl rand -hex 32)
ENCRYPTION_KEY=replace_this_with_your_32_byte_hex_key_here
# Директория с проектами (compose-файлами). Важно для 1:1 монтирования.
PROJECTS_DIRECTORY=/opt/docker
# Права доступа (узнать в терминале, команды: id -u и id -g)
PUID=1000
PGID=1000

#################
# СЕТЕВЫЕ НАСТРОЙКИ
#################
# IP хоста, на котором будет слушать веб-интерфейс Arcane
HOST_IP=127.0.0.1
# Порт HTTP веб-интерфейса Arcane
ARCANE_HTTP_PORT=3552
# Внешний URL для корректной работы менеджера
# ЕСЛИ БУДЕТ ВНЕШНИЙ ДОМЕН И HTTPS (через Reverse Proxy), 
# указать строку, которая вбивается в браузере, например:
# APP_URL=https://arcane.yourdomain.com
APP_URL=http://${HOST_IP}:${ARCANE_HTTP_PORT}